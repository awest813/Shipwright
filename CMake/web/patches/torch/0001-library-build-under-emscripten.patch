     if(EMSCRIPTEN_PRELOAD)
         set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} --preload-file ${EMSCRIPTEN_PRELOAD}")
@@ -224,6 +224,11 @@ if (MSVC)
     add_compile_definitions(NOMINMAX _USE_MATH_DEFINES)
 endif()
 
+# The embind wrapper is only for the standalone web build; it also redefines Companion::Instance.
+if(NOT USE_STANDALONE)
+    list(FILTER SRC_DIR EXCLUDE REGEX "src/lib/web.cpp")
+endif()
+
 # Build
 if (USE_STANDALONE)
     add_definitions(-DSTANDALONE)
