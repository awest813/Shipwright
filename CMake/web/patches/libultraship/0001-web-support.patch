 namespace Ship {
 
+// Queues a task on the resource thread pool. The single-threaded web build has no pool, so the
+// task runs right away and the caller gets back an already-satisfied future.
+template <typename F> static auto SubmitTask(BS::thread_pool* pool, F&& task, BS::priority_t priority = 0) {
+#ifdef __EMSCRIPTEN__
+    using R = std::invoke_result_t<std::decay_t<F>>;
+    std::promise<R> promise;
+    try {
+        if constexpr (std::is_void_v<R>) {
+            task();
+            promise.set_value();
+        } else {
+            promise.set_value(task());
+        }
+    } catch (...) { promise.set_exception(std::current_exception()); }
+    return promise.get_future();
+#else
+    return pool->submit_task(std::forward<F>(task), priority);
+#endif
+}
