 void GfxRenderingAPIOGL::EndFrame() {
+#ifdef __EMSCRIPTEN__
+    // RAF reaches an implicit WebGL frame boundary. Keep the explicit flush for
+    // timer-driven loops: SDL's VSync setting can change Emscripten's timing mode.
+    int timingMode = EM_TIMING_SETTIMEOUT;
+    emscripten_get_main_loop_timing(&timingMode, nullptr);
+    if (timingMode == EM_TIMING_RAF)
+        return;
+#endif
     glFlush();
 }
 
