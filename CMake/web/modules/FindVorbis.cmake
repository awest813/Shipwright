    set_target_properties(Vorbis::vorbisenc PROPERTIES INTERFACE_COMPILE_OPTIONS "-sUSE_VORBIS=1" INTERFACE_LINK_OPTIONS "-sUSE_VORBIS=1")
endif()
if(NOT TARGET Vorbis::vorbisfile)
    add_library(Vorbis::vorbisfile INTERFACE IMPORTED GLOBAL)
    set_target_properties(Vorbis::vorbisfile PROPERTIES INTERFACE_COMPILE_OPTIONS "-sUSE_VORBIS=1" INTERFACE_LINK_OPTIONS "-sUSE_VORBIS=1")
endif()
set(Vorbis_FOUND TRUE)
