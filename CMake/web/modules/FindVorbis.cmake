# Emscripten build: provided by the emscripten port (-sUSE_VORBIS=1), no library search needed.
if(NOT TARGET Vorbis::vorbis)
    add_library(Vorbis::vorbis INTERFACE IMPORTED GLOBAL)
    set_target_properties(Vorbis::vorbis PROPERTIES INTERFACE_COMPILE_OPTIONS "-sUSE_VORBIS=1" INTERFACE_LINK_OPTIONS "-sUSE_VORBIS=1")
endif()
